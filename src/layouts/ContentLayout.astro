---
/**
 * 内容页外壳（tutorials / faq / changelog / roadmap，后续 pricing / privacy / terms 也用）：
 * 深色紧凑页头 + 浅色正文；默认 JSON-LD 为 WebPage，可整体替换。
 * slot: 默认（正文）/ hero（页头下方的附加内容，如搜索框、统计）
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/pages/content.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  /** 站内路径，如 'faq.html' */
  path: string;
  page: string;
  /** 页头：英文眉标 / 中文徽标与图标 / 标题 / 高亮 / 描述 */
  eyebrow: string;
  badge: string;
  badgeIcon: string;
  heading: string;
  highlight?: string;
  desc: string;
  /** 额外的 JSON-LD 节点（与 WebPage 一起放进 @graph） */
  graph?: Record<string, unknown>[];
}
const { title, description, keywords, path, page, eyebrow, badge, badgeIcon, heading, highlight, desc, graph = [] } = Astro.props;

const pageUrl = `${site.url}/${path}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'zh-CN',
      isPartOf: { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: `${site.name} ${site.nameEn}` },
    },
    ...graph,
  ],
};
---
<BaseLayout {title} {description} {keywords} {path} {page} {jsonLd}>
  <section class="chero" data-theme="dark" aria-labelledby="cheroTitle">
    <div class="chero-bg" aria-hidden="true">
      <div class="signal-grid chero-grid">
        <span class="signal-pulse" style="--y:120px;--dur:10s"></span>
        <span class="signal-pulse is-v" style="--x:220px;--dur:12s;--delay:3s"></span>
      </div>
    </div>
    <div class="container chero-inner">
      <p class="chero-eyebrow mono" data-reveal="up">
        <span class="chero-badge"><Icon name={badgeIcon} /> {badge}</span>
        <span data-scramble>{eyebrow}</span>
      </p>
      <h1 class="chero-title" id="cheroTitle" data-reveal="mask" style="--rd:0.08s">
        <span class="mask"><span>{heading}{highlight && <span class="grad-text">{highlight}</span>}</span></span>
      </h1>
      <p class="chero-desc" data-reveal="up" style="--rd:0.2s">{desc}</p>
      {Astro.slots.has('hero') && <div class="chero-extra" data-reveal="up" style="--rd:0.3s"><slot name="hero" /></div>}
    </div>
  </section>

  <div class="cbody" data-theme="light">
    <slot />
  </div>
</BaseLayout>
