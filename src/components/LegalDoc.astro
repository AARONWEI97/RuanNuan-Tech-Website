---
/**
 * 条款类文档版式：左侧吸顶目录（当前章节高亮）+ 右侧正文。
 * 正文用 <section id> + <h2> 书写，目录由 toc 传入，id 必须一一对应。
 */
import Icon from './Icon.astro';
import '../styles/pages/legal.css';
import { url } from '../lib/url';

interface Props {
  toc: { id: string; label: string }[];
  /** 另一份条款（隐私 ↔ 使用条款） */
  sibling: { href: string; label: string };
}
const { toc, sibling } = Astro.props;
---
<div class="container legal">
  <aside class="legal-aside">
    <nav class="legal-toc" aria-label="页面目录">
      <p class="legal-toc-title mono">CONTENTS · 目录</p>
      <ol role="list">
        {toc.map((t, i) => (
          <li><a href={`#${t.id}`} data-toc-link={t.id}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{t.label}</a></li>
        ))}
      </ol>
    </nav>
    <div class="legal-aside-links">
      <a href={url(sibling.href)}><Icon name="fa6-solid:file-lines" /> {sibling.label}</a>
      <a href={url('index.html')}><Icon name="fa6-solid:arrow-left" /> 返回首页</a>
    </div>
  </aside>
  <article class="legal-prose" data-toc-body>
    <slot />
  </article>
</div>

<script>
  /** 目录高亮：视口上部 1/3 处所在章节 */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const io = new IntersectionObserver((entries) => entries.forEach((en) => {
    if (!en.isIntersecting) return;
    links.forEach((a) => (a.dataset.tocLink === en.target.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  }), { rootMargin: '-25% 0px -70% 0px' });
  links.forEach((a) => { const s = document.getElementById(a.dataset.tocLink!); if (s) io.observe(s); });
</script>
